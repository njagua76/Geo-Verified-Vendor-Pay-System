# M-Pesa Daraja API Configuration
# Get these credentials from https://developer.safaricom.co.ke/

# Sandbox credentials (for testing)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379  # Test shortcode for sandbox
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Environment: 'sandbox' for testing, 'production' for real money
MPESA_ENVIRONMENT=sandbox

# Callback URL for payment confirmations
# For local development, use ngrok: https://ngrok.com/
# Example: https://abc123.ngrok.io/api/suppliers/payment/callback
MPESA_CALLBACK_URL=http://localhost:5000/api/suppliers/payment/callback

# Database Configuration
DATABASE_URL=postgresql://geo_user:9090@localhost:5432/geo_vendor_db

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key-change-in-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


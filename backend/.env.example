# Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://geo_user:9090@localhost:5432/geo_vendor_db

# JWT Configuration
# Use a secure random string generated with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secure-secret-key-here

# JWT token expiration in hours
JWT_EXPIRATION_HOURS=24

# Environment (development or production)
FLASK_ENV=development

# CORS Origins (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

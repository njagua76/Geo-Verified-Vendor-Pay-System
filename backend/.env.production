# Production Database Configuration
# Replace with your actual production database URL
DATABASE_URL=postgresql://user:password@prod-db-host:5432/geo_vendor_db

# Production JWT Secret (MUST be changed from development)
JWT_SECRET_KEY=YOUR_PRODUCTION_SECRET_KEY_HERE

# JWT Configuration
JWT_EXPIRATION_HOURS=24

# Environment
FLASK_ENV=production

# CORS Origins (Update with your production frontend URL)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
